{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: gcc.exe 编译整个项目",
            "command": "D:\\mingw64\\bin\\gcc.exe",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}\\menu.c",
                "${workspaceFolder}\\search.c",
                "${workspaceFolder}\\insert.c",
                "${workspaceFolder}\\delete.c",
                "${workspaceFolder}\\sort.c",
                "${workspaceFolder}\\sortById.c",
                "${workspaceFolder}\\readAndwrite.c",
                "${workspaceFolder}\\type_out.c",
                "${workspaceFolder}\\report.c",
                "${workspaceFolder}\\aggregate.c",
      
                "-I",
                "D:\\curl-8.23.0_8-win64-mingw\\include",
                "-L",
                "D:\\curl-8.23.0_8-win64-mingw\\lib",
                "-lcurl",
                "-o",
                "${workspaceFolder}\\grade_management.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "D:\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}